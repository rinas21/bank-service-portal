# Bank Service Portal — environment configuration
# Copy this file to .env and replace every placeholder before running
# `docker compose up --build`. The .env file is git-ignored; never commit it.

# --- SQL Server -------------------------------------------------------------
# Must satisfy the SQL Server password policy: at least 8 characters from
# three of upper case, lower case, digits and symbols.
MSSQL_SA_PASSWORD=ChangeMe_Str0ng!Pass
SQL_DATABASE=BankServicePortal
SQL_PORT=1433

# --- API --------------------------------------------------------------------
# A cryptographically random value of at least 64 characters. Generate one with:
#   openssl rand -base64 64 | tr -d '\n'
Jwt__Key=CHANGE_ME_openssl_rand_base64_64_output_here_minimum_64_characters_long_000
Jwt__Issuer=BankServicePortal
Jwt__Audience=BankServicePortal
Jwt__ExpiryMinutes=60

ASPNETCORE_ENVIRONMENT=Production
SWAGGER_ENABLED=true
API_PORT=8081

# --- Frontend ---------------------------------------------------------------
FRONTEND_PORT=8080

# Baked into the JS bundle at build time by Vite. Leave as /api to use the nginx
# proxy on the same origin.
VITE_API_BASE_URL=/api

# --- Reverse proxy ----------------------------------------------------------
# The rate limiter partitions per client IP. The bundled nginx config appends the
# real peer address to X-Forwarded-For and the app trusts only the right-most
# entry, so spoofed values are ignored. Set this to true and list KnownProxies to
# accept forwarded headers only from those addresses instead of any peer.
ForwardedHeaders__TrustKnownProxies=false
